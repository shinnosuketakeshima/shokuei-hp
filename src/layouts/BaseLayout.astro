---
import '../index.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { PAGE_META, getKeywords } from '../data/pageMeta.js'
import { buildPageJsonLd, buildBreadcrumbJsonLd } from '../lib/seo.js'

const BASE_URL = 'https://shokuei-hp.web.app'
const SITE_NAME = '十文字学園女子大学 食物栄養学科'

// build.format:'file' ではビルド時 pathname が /foo.html になるため正規化する
let pathname = Astro.url.pathname.replace(/\.html$/, '')
if (pathname === '' || pathname === '/index') pathname = '/'

// 404など PAGE_META 外のページは meta prop で明示的に渡す
const { meta: metaOverride, noindex = false } = Astro.props
const meta = metaOverride ?? PAGE_META[pathname]
if (!meta) {
  throw new Error(
    `PAGE_META に ${pathname} が未登録です。src/data/pageMeta.js にエントリを追加してください。`
  )
}

const url = `${BASE_URL}${pathname}`
const keywords = metaOverride ? null : getKeywords(pathname)
const pageJsonLd = buildPageJsonLd(pathname, meta)
const breadcrumbJsonLd = metaOverride ? null : buildBreadcrumbJsonLd(pathname, meta.title)

// index.html にあった静的な組織情報 JSON-LD（全ページ共通・現行挙動の踏襲）
const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'EducationalOrganization',
  '@id': 'https://shokuei-hp.web.app/#organization',
  name: '十文字学園女子大学 食物栄養学科',
  alternateName: 'Jumonji University Food and Nutrition',
  url: 'https://shokuei-hp.web.app/',
  description: '埼玉県新座市にある十文字学園女子大学 食物栄養学科（人間生活学部）の非公式情報メディア。4年間を通じた実践的なカリキュラム、国家試験合格率を支えるサポート体制、最新の研究室情報など、食と栄養のプロフェッショナルを目指す高校生に向けたリアルな学びの魅力を発信します。',
  parentOrganization: {
    '@type': 'CollegeOrUniversity',
    name: '十文字学園女子大学',
    url: 'https://www.jumonji-u.ac.jp/',
    address: {
      '@type': 'PostalAddress',
      addressCountry: 'JP',
      addressRegion: '埼玉県',
      addressLocality: '新座市',
    },
  },
  address: {
    '@type': 'PostalAddress',
    streetAddress: '埼玉県新座市菅沢2-1-28',
    addressLocality: '新座市',
    addressRegion: '埼玉県',
    postalCode: '352-8510',
    addressCountry: 'JP',
  },
  telephone: '+81-48-481-1111',
  geo: {
    '@type': 'GeoCoordinates',
    latitude: '35.8193',
    longitude: '139.6291',
  },
  areaServed: {
    '@type': 'Country',
    name: 'JP',
  },
  inLanguage: 'ja-JP',
  availableLanguage: 'ja',
}
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="google-site-verification" content="_NqjypcGRuI7BuwwhHrvPEIFz9cmWmGblMYnmiSnuhE" />

    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    {keywords && <meta name="keywords" content={keywords} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={url} />
    <link rel="alternate" hreflang="ja" href={url} />
    <link rel="alternate" hreflang="ja-JP" href={url} />

    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={url} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={meta.ogType ?? 'website'} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:image" content="https://shokuei-hp.web.app/og-image.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content="https://shokuei-hp.web.app/og-image.jpg" />

    <meta name="geo.position" content="35.8193;139.6291" />
    <meta name="ICBM" content="35.8193, 139.6291" />
    <meta name="geo.placename" content="新座市, 埼玉県, 日本" />
    <meta name="geo.region" content="JP-11" />

    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(pageJsonLd)} />
    {breadcrumbJsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
    )}

    <slot name="head" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@300;400;500&family=Noto+Serif+JP:wght@400;500;700;900&display=swap" rel="stylesheet" />

    <script is:inline>document.documentElement.classList.add('js')</script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-3WFCXK3WH8"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-3WFCXK3WH8');
      document.addEventListener('click', function (e) {
        var t = e.target.closest('[data-ga-click]');
        if (t && typeof gtag === 'function') {
          gtag('event', t.getAttribute('data-ga-event') || 'click_cta', {
            event_category: t.getAttribute('data-ga-category') || 'CTA',
            event_label: t.getAttribute('data-ga-click'),
            page_path: location.pathname,
          });
        }
      });
    </script>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/reveal.js'
    </script>
  </body>
</html>
