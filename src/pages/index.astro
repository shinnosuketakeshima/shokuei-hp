---
import BaseLayout from '../layouts/BaseLayout.astro'
import HeroBg from '../top.jpg'
import Hero from '../components/Hero.astro'
import UpcomingEvents from '../components/UpcomingEvents.astro'
import AudienceGuide from '../components/AudienceGuide.astro'
import StatsBar from '../components/StatsBar.astro'
import Features from '../components/Features.astro'
import Qualifications from '../components/Qualifications.astro'
import NationalExamSupport from '../components/NationalExamSupport.astro'
import Career from '../components/Career.astro'
import ValueStory from '../components/ValueStory.astro'
import ChairMessageTeaser from '../components/ChairMessageTeaser.astro'
import CategoryBanners from '../components/CategoryBanners.astro'
import Labs from '../components/Labs.astro'
import CampusLife from '../components/CampusLife.astro'
import RealVoices from '../components/RealVoices.astro'
import News from '../components/News.astro'
import FAQ from '../components/FAQ.astro'
import SNSSection from '../components/SNSSection.astro'
---

{/*
  ホームの並びは「FV → 対象別導線 → 強み（数字・特色）→ 出口（資格・国試・進路）
  → 理念 → 学び（研究室）→ リアル（キャンパス・声・コラム・特集）→ お知らせ → FAQ → SNS」。
  新規訪問者が離脱する前に USP と将来像を見せ、お知らせは末尾でコンパクトに扱う。
*/}
<BaseLayout>
  <link slot="head" rel="preload" as="image" href={HeroBg.src} />
  <Hero />
  <UpcomingEvents />
  <AudienceGuide />
  <StatsBar />
  <Features summary={true} />
  <Qualifications summary={true} />
  <NationalExamSupport summary={true} />
  <Career summary={true} />
  <ValueStory />
  <ChairMessageTeaser />
  <CategoryBanners />
  <Labs />
  <CampusLife summary={true} />
  <RealVoices />
  <News />
  <FAQ summary={true} />
  <SNSSection />
</BaseLayout>
