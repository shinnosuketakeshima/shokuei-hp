---
import { ArrowRight } from '@lucide/astro'

const CATEGORY_LABELS = {
  regional: '地域連携・商品開発',
  science: '最先端サイエンス',
  welfare: '子ども・高齢者・福祉',
}

const LAB_STORIES = [
  {
    storyTitle: '黒たまねぎマフィンと、おいしい健康の科学',
    hook: 'ポリフェノール解析から地域企業とつくる「くろたまフィン」。',
    interest: '商品開発に挑戦したい',
    category: 'regional',
    href: '/lab-kamiyama',
  },
  {
    storyTitle: 'プラスちゃんナッツと、すったてうどんの挑戦',
    hook: '企業・地域とつなぐ、栄養管理技術の社会還元。',
    interest: '地域や企業とつながりたい',
    category: 'regional',
    href: '/lab-kunii',
  },
  {
    storyTitle: 'おだんごの「おいしさ」を、科学で解き明かす',
    hook: '和菓子職人の経験と調理科学が出会う場所。',
    interest: '「好き」を学問にしたい',
    category: 'regional',
    href: '/lab-shibasaki',
  },
  {
    storyTitle: '市民健康まつりと、子ども食堂の食の現場',
    hook: 'エビデンスに基づく公衆栄養を、地域で実践する。',
    interest: '人と関わる仕事がしたい',
    category: 'regional',
    href: '/lab-komeichi',
  },
  {
    storyTitle: 'ウイルスと遺伝子で、命の食卓を守る',
    hook: 'BLVとBoLA。顕微鏡の向こうで動く One Health。',
    interest: '実験や研究が好き',
    category: 'science',
    href: '/lab-takeshima',
  },
  {
    storyTitle: 'キンギョとゼブラフィッシュが教えてくれる老化のヒミツ',
    hook: '鱗・皮膚の再生から、食品成分の分子レベル解析へ。',
    interest: '生き物や生命科学に興味がある',
    category: 'science',
    href: '/lab-iimura',
  },
  {
    storyTitle: 'テンペとおからで、おいしく続ける健康食',
    hook: '被験者と試作を重ねる、食物繊維の調理科学。',
    interest: '食べることが好き',
    category: 'science',
    href: '/lab-kamoshita',
  },
  {
    storyTitle: 'グルテンフリーパンと、データで解くおいしさ',
    hook: '雑穀粉・アレルギー対応レシピの物性評価。',
    interest: 'データで考えるのが好き',
    category: 'science',
    href: '/lab-ishii',
  },
  {
    storyTitle: 'そのサプリ、本当に安全？健康食品を守るリスク評価の科学',
    hook: '薬物相互作用・CYP解析から独自の安全基準SDI-SEまで。',
    interest: '安全・安心を守る仕事がしたい',
    category: 'science',
    href: '/lab-yamazaki',
  },
  {
    storyTitle: '内視鏡とAIが拓く、腸と健康の未来',
    hook: 'マイクロバイオームから臨床研究まで。',
    interest: '医療やAIに関心がある',
    category: 'science',
    href: '/lab-niikura',
  },
  {
    storyTitle: '食育と子どもの健康を、多角的に科学する',
    hook: '調査研究・実践活動・基礎研究で、子どもの心身の成長をサポート。',
    interest: '子どもの成長に関わりたい',
    category: 'welfare',
    href: '/lab-nakaoka',
  },
  {
    storyTitle: '超高齢社会の食と、介護現場の栄養ケア',
    hook: 'サルコペニア予防から施設マネジメントまで。',
    interest: '高齢者を支える仕事がしたい',
    category: 'welfare',
    href: '/lab-okamoto',
  },
]
---

<section class="section labs-portal" id="labs">
  <div class="container">
    <div class="section__header" data-reveal>
      <h2 class="section__title">12の研究室ストーリー</h2>
      <p class="section__subtitle">Lab Stories</p>
      <p class="labs-portal__lead">
        教員プロフィールや研究業績の一覧ではなく、ゼミごとの「物語」から入れます。気になるテーマを選んで、詳細ページへ。
      </p>
    </div>

    <div class="labs-portal__filters" role="tablist" aria-label="研究室カテゴリ">
      <button
        type="button"
        role="tab"
        aria-selected="true"
        class="labs-portal__filter labs-portal__filter--active"
        data-lab-filter=""
      >
        すべて
      </button>
      {Object.entries(CATEGORY_LABELS).map(([key, label]) => (
        <button
          type="button"
          role="tab"
          aria-selected="false"
          class={`labs-portal__filter labs-portal__filter--${key}`}
          data-lab-filter={key}
        >
          {label}
        </button>
      ))}
    </div>

    <div class="labs-story-grid" data-lab-grid>
      {LAB_STORIES.map((lab, i) => (
        <article
          class={`lab-story-card lab-story-card--${lab.category}`}
          data-lab-card
          data-category={lab.category}
          data-reveal
          style={`--reveal-delay: ${(i % 6) * 0.06}s`}
        >
          <a href={lab.href} class="lab-story-card__inner" aria-label={`${lab.storyTitle}のストーリーを読む`}>
            <span class="lab-story-card__category">{CATEGORY_LABELS[lab.category]}</span>
            <h3 class="lab-story-card__title">{lab.storyTitle}</h3>
            <p class="lab-story-card__hook">{lab.hook}</p>
            {lab.interest && <span class="lab-story-card__interest">こんな人へ：{lab.interest}</span>}
            <span class="lab-story-card__link">
              ストーリーを読む <ArrowRight size={14} aria-hidden="true" />
            </span>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  // React版のuseState/AnimatePresenceによるカテゴリ絞り込みをvanilla化。
  // ハッシュ(#labs-regional 等)と絞り込みボタンの状態を相互同期する。
  function initLabsFilter() {
    const section = document.getElementById('labs')
    if (!section) return
    const buttons = section.querySelectorAll<HTMLElement>('[data-lab-filter]')
    const cards = section.querySelectorAll<HTMLElement>('[data-lab-card]')

    const applyFilter = (category: string) => {
      cards.forEach((card) => {
        const match = !category || card.getAttribute('data-category') === category
        card.style.display = match ? '' : 'none'
      })
      buttons.forEach((btn) => {
        const isActive = btn.getAttribute('data-lab-filter') === (category || '')
        btn.classList.toggle('labs-portal__filter--active', isActive)
        btn.setAttribute('aria-selected', String(isActive))
      })
    }

    const syncFromHash = () => {
      const hash = window.location.hash.replace('#', '')
      const category = ['labs-regional', 'labs-science', 'labs-welfare'].includes(hash)
        ? hash.replace('labs-', '')
        : ''
      applyFilter(category)
      if (hash.startsWith('labs')) {
        section.scrollIntoView({ behavior: 'smooth', block: 'start' })
      }
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const category = btn.getAttribute('data-lab-filter') || ''
        window.location.hash = category ? `labs-${category}` : 'labs'
        applyFilter(category)
      })
    })

    window.addEventListener('hashchange', syncFromHash)
    syncFromHash()
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLabsFilter)
  } else {
    initLabsFilter()
  }
</script>
