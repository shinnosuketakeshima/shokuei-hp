---
---

<section class="sns">
  <div class="container">
    <div class="sns__header" data-reveal>
      <p class="eyebrow">SNS / Social Media</p>
      <h2 class="section-title">学科のいまを発信中</h2>
      <p style="margin-top: 14px; font-size: 14px; color: var(--stone)">
        授業・実習・学生生活の様子をリアルタイムで発信しています。
      </p>
    </div>

    <div class="sns__grid">
      <a
        href="https://www.instagram.com/jumonji_shokuei/"
        target="_blank"
        rel="noopener noreferrer"
        class="sns-card sns-card--instagram"
        aria-label="Instagram @jumonji_shokuei"
        data-reveal="scale"
        style="--reveal-delay: 0.2s"
      >
        <div class="sns-card__icon">
          <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none" />
          </svg>
        </div>
        <p class="sns-card__name">Instagram</p>
        <p class="sns-card__handle">@jumonji_shokuei</p>
        <div class="sns-card__hover">
          <span class="sns-card__cta">フォローする</span>
        </div>
      </a>

      <a
        href="https://www.tiktok.com/@ishokssov49"
        target="_blank"
        rel="noopener noreferrer"
        class="sns-card sns-card--tiktok"
        aria-label="TikTok @ishokssov49"
        data-reveal="scale"
        style="--reveal-delay: 0.3s"
      >
        <div class="sns-card__icon">
          <svg width="44" height="44" viewBox="0 0 24 24" fill="currentColor">
            <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.34 6.34 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.28 8.28 0 004.84 1.55V6.79a4.85 4.85 0 01-1.07-.1z" />
          </svg>
        </div>
        <p class="sns-card__name">TikTok</p>
        <p class="sns-card__handle">@ishokssov49</p>
        <div class="sns-card__hover">
          <span class="sns-card__cta">フォローする</span>
        </div>
      </a>
    </div>
  </div>
</section>
