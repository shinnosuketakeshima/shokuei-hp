---
import { ArrowRight } from '@lucide/astro'
import { AUDIENCES } from '../data/audiences.js'
---

<section class="audience" id="audience" aria-labelledby="audience-guide-heading">
  <div class="container">
    <div class="audience__header" data-reveal>
      <p id="audience-guide-heading" class="audience__title">あなたに合わせて読む</p>
      <p class="audience__hint" aria-hidden="true">横にスワイプ →</p>
    </div>

    <div class="audience__track">
      {AUDIENCES.map((a, i) => {
        const Icon = a.icon
        return (
          <div
            class="audience-card"
            id={`audience-${a.id}`}
            data-reveal
            style={`--reveal-delay: ${i * 0.08}s`}
          >
            <div class="audience-card__head">
              <span class="audience-card__icon">
                <Icon size={18} aria-hidden="true" />
              </span>
              <h3 class="audience-card__label">{a.label}</h3>
            </div>
            <p class="audience-card__desc">{a.description}</p>
            <ul class="audience-card__links">
              {a.links.map((link) => (
                <li>
                  <a href={link.href} class="audience-card__link">
                    {link.label}
                    <ArrowRight size={13} aria-hidden="true" />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      })}
    </div>
  </div>
</section>
