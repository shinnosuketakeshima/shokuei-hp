---
const DORM_ROOMS = [
  { label: '67,700円タイプ', monthly: 67700 },
  { label: '75,000円タイプ', monthly: 75000 },
  { label: '82,000円タイプ', monthly: 82000 },
]

const APT_RENTS = [
  { label: '4.5万円タイプ', monthly: 45000 },
  { label: '5.5万円タイプ', monthly: 55000 },
  { label: '6.5万円タイプ', monthly: 65000 },
]

const DORM_FIXED = {
  entry: 290000,
  deposit: 50000,
  mgmtYear: 220000,
  netMonthly: 3960,
}

const TUITION = {
  admission: 250000,
  tuitionYear: 800000,
  facilityYear: 400000,
  feesYear: 64660,
}

const FAQ_ITEMS = [
  { q: '新座で一人暮らしすると月いくらかかりますか？', a: '十文字学園女子大学周辺のアパートは家賃月4.5〜6.5万円が目安です。光熱費・食費・通信費を含めると、月8〜12万円程度が一般的な生活費の目安です。学生寮（ドーミー）を選ぶと、朝夕2食付き・家具家電込みのため、月額6.7〜8.2万円＋電気代で生活費がほぼ確定します。' },
  { q: '新座市のアパート家賃相場はいくらですか？', a: '大学周辺（新座駅・ひばりヶ丘駅方面）のワンルーム・1Kは、家賃月4.5〜6.5万円が相場です。初期費用は敷金・礼金・仲介手数料などで家賃の4〜6か月分が目安になります。' },
  { q: '十文字学園女子大学の学生寮の費用はいくらですか？', a: 'ドーミー（共立メンテナンス）の寮費は月67,700〜82,000円（2025年時点）。入館費29万円・保証金5万円・年間管理費22万円が別途かかります。初年度の総額は約142〜158万円（電気代別）が目安です。' },
  { q: '食物栄養学科の4年間の学費はいくらですか？', a: '2026年度入学者の初年度納入金は約151万円（入学金25万円＋授業料80万円＋施設費40万円＋諸会費等）。2年目以降は入学金なしで年間約126万円。4年間の学費総額は約531万円です。最新の正確な金額は大学公式サイトの募集要項でご確認ください。' },
  { q: '学生寮とアパート、どちらが安いですか？', a: '家賃だけ見るとアパートの方が安く見えますが、寮は食事2食・家具家電・管理費込みで計算できます。4年間の住居費総額では大きな差にならないことも多く、食費やセキュリティの安心感も含めて選ぶのがおすすめです。' },
]

const yen = (n: number) => n.toLocaleString('ja-JP') + '円'

function calcDorm(monthly: number) {
  const room = monthly * 12
  const net = DORM_FIXED.netMonthly * 12
  const firstYear = room + DORM_FIXED.mgmtYear + net + DORM_FIXED.entry + DORM_FIXED.deposit
  const fourYear = room * 4 + DORM_FIXED.mgmtYear * 4 + net * 4 + DORM_FIXED.entry + DORM_FIXED.deposit
  return { room, net, firstYear, fourYear }
}

function calcApt(monthly: number) {
  const annualRent = monthly * 12
  const initial = monthly * 5
  const firstYear = annualRent + initial
  const fourYear = annualRent * 4 + initial
  return { annualRent, initial, firstYear, fourYear }
}

function calcTuition() {
  const year1 = TUITION.admission + TUITION.tuitionYear + TUITION.facilityYear + TUITION.feesYear
  const yearN = TUITION.tuitionYear + TUITION.facilityYear + TUITION.feesYear
  const fourYear = year1 + yearN * 3
  return { year1, yearN, fourYear }
}

const t = calcTuition()
const dormBreakdowns = DORM_ROOMS.map((r) => ({ ...r, ...calcDorm(r.monthly) }))
const aptBreakdowns = APT_RENTS.map((r) => ({ ...r, ...calcApt(r.monthly) }))

const initialRoom = dormBreakdowns[0]
const initialApt = aptBreakdowns[1]
---

<div class="la">
  <header class="la-hero">
    <p class="la-eyebrow">新座 一人暮らし 費用シミュレーター</p>
    <h1 class="la-title">
      新座で一人暮らし——<br />
      <span class="la-accent">住まい</span>と
      <span class="la-accent">学費</span>を総額で比較
    </h1>
    <p class="la-lead">
      埼玉県<strong>新座市</strong>にある十文字学園女子大学 食物栄養学科へ進学する際、
      受験生・保護者の方が最も気になる「<strong>新座で一人暮らしするといくらかかるのか</strong>」。
      月額の家賃や寮費だけでは見えない<strong>年間・4年間の総額</strong>で、
      学生寮・アパート・学費をこのページのシミュレーターで比較できます。
    </p>
  </header>

  <section class="la-local" aria-labelledby="la-local-heading">
    <h2 id="la-local-heading" class="la-h2">新座市で一人暮らしする費用の目安</h2>
    <p>
      十文字学園女子大学は埼玉県新座市菅沢にあり、JR武蔵野線・新座駅から徒歩10〜15分です。
      ひばりヶ丘駅方面からバスでのアクセスも可能で、池袋から急行で約20分と都心へも通いやすい立地です。
    </p>
    <ul class="la-local-list">
      <li><strong>学生寮（ドーミー）</strong>：月6.7〜8.2万円、朝夕2食・家具家電込み</li>
      <li><strong>アパート・マンション</strong>：新座周辺の家賃相場 月4.5〜6.5万円</li>
      <li><strong>学費（食物栄養学科）</strong>：初年度約151万円、4年間総額約531万円</li>
    </ul>
    <p class="la-local-note">
      住居費と学費を合わせた4年間の総額は、下のシミュレーターで寮タイプ・家賃タイプを選んで確認できます。
      詳しいキャンパス環境は<a href="/campus-life">キャンパスライフ</a>もご覧ください。
    </p>
  </section>

  <section class="la-choices">
    <article class="la-card la-card--dorm">
      <h2>学生寮（ドーミー）</h2>
      <ul>
        <li>朝・夕の2食付き</li>
        <li>家具・家電がそろっている</li>
        <li>オートロック・管理人常駐で安心</li>
        <li>引越しの荷物が少なくてすむ</li>
      </ul>
      <p class="la-card-cost">
        初年度費用の目安 <strong>約142万円〜</strong>
        <span>（電気代別）</span>
      </p>
    </article>

    <article class="la-card la-card--apt">
      <h2>アパート・マンション（新座周辺）</h2>
      <ul>
        <li>新座市周辺の家賃相場は月 4.5〜6.5万円</li>
        <li>自炊など生活スタイルを自由に選べる</li>
        <li>毎年の管理費（約22万円）が通常かからない</li>
        <li>工夫しだいで費用を抑えられる場合も</li>
      </ul>
      <p class="la-card-cost">
        初期費用の目安 <strong>家賃の4〜6か月分</strong>
        <span>（敷金・礼金・仲介手数料など）</span>
      </p>
    </article>
  </section>

  <section class="la-sim" aria-labelledby="la-dorm-sim-heading">
    <p class="la-eyebrow">一人暮らしコスト比較｜学生寮</p>
    <h2 id="la-dorm-sim-heading" class="la-h2">学生寮の費用シミュレーター</h2>
    <p class="la-sim-note">
      寮費（月額）のほかに、入館費・保証金・年間管理費・通信費がかかります。
      部屋タイプを選ぶと、1年目と4年間の総額の目安が出ます。
    </p>

    <div class="la-tabs" role="tablist" aria-label="寮の部屋タイプ">
      {dormBreakdowns.map((r, i) => (
        <button
          type="button"
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-controls="la-dorm-breakdown"
          aria-label={`${r.label}を選択`}
          class={'la-tab' + (i === 0 ? ' is-active' : '')}
          data-la-dorm-tab={i}
        >
          {r.label}
        </button>
      ))}
    </div>

    <div id="la-dorm-breakdown" class="la-breakdown" role="tabpanel">
      <div class="la-bd-col">
        <h3>1年目にかかるお金</h3>
        <dl>
          <div><dt data-la-dorm-field="rentLabel">寮費（{yen(initialRoom.monthly)}×12か月）</dt><dd data-la-dorm-field="room">{yen(initialRoom.room)}</dd></div>
          <div><dt>年間管理費</dt><dd>{yen(DORM_FIXED.mgmtYear)}</dd></div>
          <div><dt>通信設備費（{yen(DORM_FIXED.netMonthly)}×12）</dt><dd data-la-dorm-field="net">{yen(initialRoom.net)}</dd></div>
          <div><dt>入館費（4年で1回）</dt><dd>{yen(DORM_FIXED.entry)}</dd></div>
          <div><dt>保証金（4年で1回）</dt><dd>{yen(DORM_FIXED.deposit)}</dd></div>
          <div class="la-bd-total"><dt>1年目合計</dt><dd data-la-dorm-field="firstYear">{yen(initialRoom.firstYear)}<span>＋電気代</span></dd></div>
        </dl>
      </div>

      <div class="la-bd-col la-bd-col--four">
        <h3>4年間の住居費合計</h3>
        <p class="la-four-num" data-la-dorm-field="fourYear">{yen(initialRoom.fourYear)}<span>＋電気代</span></p>
        <p class="la-four-sub">
          入館費・保証金は4年で1回、寮費・管理費・通信費は毎年かかる前提の目安です。
        </p>
      </div>
    </div>

    <p class="la-disclaimer">
      ※ 金額は2025年時点の公開情報をもとにした目安です。部屋タイプや契約年により変わります。
      最新の正確な費用は、必ずドーミー（共立メンテナンス）の資料・公式サイトでご確認ください。
    </p>
  </section>

  <section class="la-sim la-sim--apt" aria-labelledby="la-apt-sim-heading">
    <p class="la-eyebrow">一人暮らしコスト比較｜アパート</p>
    <h2 id="la-apt-sim-heading" class="la-h2">新座市アパートの費用シミュレーター</h2>
    <p class="la-sim-note">
      新座市周辺の家賃相場（月4.5〜6.5万円）をもとに、初期費用（家賃5か月分）と
      1年目・4年間の住居費を試算します。食費・光熱費・家具家電は含みません。
    </p>

    <div class="la-tabs" role="tablist" aria-label="アパートの家賃タイプ">
      {aptBreakdowns.map((r, i) => (
        <button
          type="button"
          role="tab"
          aria-selected={i === 1 ? 'true' : 'false'}
          aria-controls="la-apt-breakdown"
          aria-label={`${r.label}を選択`}
          class={'la-tab' + (i === 1 ? ' is-active' : '')}
          data-la-apt-tab={i}
        >
          {r.label}
        </button>
      ))}
    </div>

    <div id="la-apt-breakdown" class="la-breakdown" role="tabpanel">
      <div class="la-bd-col">
        <h3>1年目にかかるお金</h3>
        <dl>
          <div><dt data-la-apt-field="rentLabel">家賃（{yen(initialApt.monthly)}×12か月）</dt><dd data-la-apt-field="annualRent">{yen(initialApt.annualRent)}</dd></div>
          <div><dt>初期費用（家賃5か月分の目安）</dt><dd data-la-apt-field="initial">{yen(initialApt.initial)}</dd></div>
          <div class="la-bd-total"><dt>1年目合計</dt><dd data-la-apt-field="firstYear">{yen(initialApt.firstYear)}<span>食費・光熱費別</span></dd></div>
        </dl>
      </div>

      <div class="la-bd-col la-bd-col--four">
        <h3>4年間の住居費合計</h3>
        <p class="la-four-num" data-la-apt-field="fourYear">{yen(initialApt.fourYear)}<span>食費・光熱費別</span></p>
        <p class="la-four-sub">
          初期費用は1回のみ、家賃は毎年かかる前提の目安です。
          寮と違い食事は自炊・外食のため、食費は別途かかります。
        </p>
      </div>
    </div>
  </section>

  <section class="la-tuition" aria-labelledby="la-tuition-heading">
    <p class="la-eyebrow">学費シミュレーター</p>
    <h2 id="la-tuition-heading" class="la-h2">食物栄養学科の学費（2026年度入学者）</h2>
    <p class="la-tuition-note">
      一人暮らしの費用とあわせて検討したい学費の目安です。
      奨学金・修学支援制度の適用により実際の負担額は変わります。
    </p>
    <div class="la-tuition-grid">
      <div class="la-tuition-card">
        <h3>初年度納入金</h3>
        <dl>
          <div><dt>入学金</dt><dd>{yen(TUITION.admission)}</dd></div>
          <div><dt>授業料（1年分）</dt><dd>{yen(TUITION.tuitionYear)}</dd></div>
          <div><dt>施設・教育充実費</dt><dd>{yen(TUITION.facilityYear)}</dd></div>
          <div><dt>諸会費等</dt><dd>{yen(TUITION.feesYear)}</dd></div>
          <div class="la-tuition-total"><dt>初年度合計</dt><dd>{yen(t.year1)}</dd></div>
        </dl>
      </div>
      <div class="la-tuition-card la-tuition-card--highlight">
        <h3>4年間の学費総額</h3>
        <p class="la-tuition-four">{yen(t.fourYear)}</p>
        <p class="la-tuition-sub">
          2年目以降は入学金なしで年間約{Math.round(t.yearN / 10000)}万円。
          最新の正確な金額は大学公式サイトの募集要項でご確認ください。
        </p>
        <a href="https://www.jumonji-u.ac.jp/admission/expense/" target="_blank" rel="noopener noreferrer" class="la-tuition-link">
          大学公式｜学費のご案内
        </a>
      </div>
    </div>
  </section>

  <section class="la-total" aria-labelledby="la-total-heading">
    <h2 id="la-total-heading" class="la-h2">4年間の総額イメージ（住居費＋学費）</h2>
    <p class="la-total-note">現在選択中のタイプでの目安です。食費・光熱費・生活費は含みません。</p>
    <div class="la-total-grid">
      <article class="la-total-card la-total-card--dorm">
        <h3>学生寮＋学費</h3>
        <p class="la-total-num" data-la-total="dorm">{yen(initialRoom.fourYear + t.fourYear)}</p>
        <p class="la-total-breakdown" data-la-total-breakdown="dorm">
          住居費 {yen(initialRoom.fourYear)} ＋ 学費 {yen(t.fourYear)}
        </p>
      </article>
      <article class="la-total-card la-total-card--apt">
        <h3>アパート＋学費</h3>
        <p class="la-total-num" data-la-total="apt">{yen(initialApt.fourYear + t.fourYear)}</p>
        <p class="la-total-breakdown" data-la-total-breakdown="apt">
          住居費 {yen(initialApt.fourYear)} ＋ 学費 {yen(t.fourYear)}
        </p>
      </article>
    </div>
  </section>

  <section class="la-compare">
    <h2 class="la-h2">寮とアパート、どう違う？</h2>
    <div class="la-table-wrap">
      <table class="la-table">
        <thead>
          <tr><th></th><th>学生寮</th><th>アパート（新座周辺）</th></tr>
        </thead>
        <tbody>
          <tr><th>食事</th><td>朝夕2食付き</td><td>自炊・外食</td></tr>
          <tr><th>家具・家電</th><td>そろっている</td><td>自分で用意</td></tr>
          <tr><th>セキュリティ</th><td>オートロック・管理人常駐</td><td>物件による</td></tr>
          <tr><th>毎年の管理費</th><td>あり（約22万円）</td><td>通常なし</td></tr>
          <tr><th>初期費用</th><td>入館費・保証金</td><td>敷金・礼金・仲介手数料</td></tr>
          <tr><th>費用の見えやすさ</th><td>入る前にほぼ確定</td><td>物件や生活で変動</td></tr>
        </tbody>
      </table>
    </div>
    <p class="la-compare-note">
      食費・家具家電・防犯まで含めて考えると、トータルでは大きな差にならないことも多いです。
      「安さ」だけでなく、生活のしやすさや安心感も含めて選ぶのがおすすめです。
    </p>
  </section>

  <section class="la-faq" aria-labelledby="la-faq-heading">
    <h2 id="la-faq-heading" class="la-h2">新座で一人暮らし——よくある質問</h2>
    <dl class="la-faq-list">
      {FAQ_ITEMS.map((item) => (
        <div class="la-faq-item">
          <dt>{item.q}</dt>
          <dd>{item.a}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="la-references">
    <h2 class="la-h2">参考になるリンク</h2>
    <div class="la-reference-grid">
      <a href="https://www.jumonji-u.ac.jp/jumonji-style/about/event-calender/" target="_blank" rel="noopener noreferrer" class="la-reference-card">
        <h3>十文字学園女子大学</h3>
        <p>受験生応援サイト イベントカレンダー</p>
      </a>
      <a href="https://www.jumonji-u.ac.jp/jumonji-style/about/campus-life/" target="_blank" rel="noopener noreferrer" class="la-reference-card">
        <h3>キャンパスライフ</h3>
        <p>新座で一人暮らしする学生の声・キャンパス風景など</p>
      </a>
      <a href="https://dormy-ac.com/page/jumonji/" target="_blank" rel="noopener noreferrer" class="la-reference-card">
        <h3>ドーミー公式サイト</h3>
        <p>十文字学園女子大学向け学生寮の詳細情報・資料請求</p>
      </a>
      <a href="https://suumo.jp/chintai/saitama/sc_niizashi/" target="_blank" rel="noopener noreferrer" class="la-reference-card">
        <h3>SUUMO（新座市）</h3>
        <p>新座市の賃貸物件検索。一人暮らし向けアパート探しに</p>
      </a>
      <a href="https://www.homes.co.jp/chintai/saitama/niiza-city/list/" target="_blank" rel="noopener noreferrer" class="la-reference-card">
        <h3>HOMES（新座市）</h3>
        <p>新座市の賃貸・家賃相場情報</p>
      </a>
      <a href="https://www.jumonji-u.ac.jp/admission/expense/" target="_blank" rel="noopener noreferrer" class="la-reference-card">
        <h3>大学公式｜学費</h3>
        <p>食物栄養学科を含む各学科の学費・奨学金情報</p>
      </a>
    </div>
  </section>

  <footer class="la-foot">
    <p>
      新座での一人暮らしや学費で迷ったら、オープンキャンパスや個別相談で気軽に聞いてください。
      先輩たちの実際の暮らし方もお伝えできます。
    </p>
  </footer>
</div>

<script>
  const yen = (n: number) => n.toLocaleString('ja-JP') + '円'

  const DORM_ROOMS = [
    { label: '67,700円タイプ', monthly: 67700 },
    { label: '75,000円タイプ', monthly: 75000 },
    { label: '82,000円タイプ', monthly: 82000 },
  ]
  const APT_RENTS = [
    { label: '4.5万円タイプ', monthly: 45000 },
    { label: '5.5万円タイプ', monthly: 55000 },
    { label: '6.5万円タイプ', monthly: 65000 },
  ]
  const DORM_FIXED = { entry: 290000, deposit: 50000, mgmtYear: 220000, netMonthly: 3960 }
  const TUITION_FOUR_YEAR = 250000 + 800000 + 400000 + 64660 + (800000 + 400000 + 64660) * 3

  function calcDorm(monthly: number) {
    const room = monthly * 12
    const net = DORM_FIXED.netMonthly * 12
    const firstYear = room + DORM_FIXED.mgmtYear + net + DORM_FIXED.entry + DORM_FIXED.deposit
    const fourYear = room * 4 + DORM_FIXED.mgmtYear * 4 + net * 4 + DORM_FIXED.entry + DORM_FIXED.deposit
    return { room, net, firstYear, fourYear }
  }

  function calcApt(monthly: number) {
    const annualRent = monthly * 12
    const initial = monthly * 5
    const firstYear = annualRent + initial
    const fourYear = annualRent * 4 + initial
    return { annualRent, initial, firstYear, fourYear }
  }

  function setText(selector: string, text: string) {
    const el = document.querySelector<HTMLElement>(selector)
    if (el) {
      const badge = el.querySelector('span')
      el.textContent = text
      if (badge) el.appendChild(badge)
    }
  }

  const dormTabs = document.querySelectorAll<HTMLElement>('[data-la-dorm-tab]')
  dormTabs.forEach((btn) => {
    btn.addEventListener('click', () => {
      const idx = Number(btn.getAttribute('data-la-dorm-tab'))
      const room = DORM_ROOMS[idx]
      const d = calcDorm(room.monthly)

      dormTabs.forEach((b) => {
        const active = b === btn
        b.classList.toggle('is-active', active)
        b.setAttribute('aria-selected', active ? 'true' : 'false')
      })

      setText('[data-la-dorm-field="rentLabel"]', `寮費（${yen(room.monthly)}×12か月）`)
      setText('[data-la-dorm-field="room"]', yen(d.room))
      setText('[data-la-dorm-field="net"]', yen(d.net))
      setText('[data-la-dorm-field="firstYear"]', yen(d.firstYear))
      setText('[data-la-dorm-field="fourYear"]', yen(d.fourYear))
      setText('[data-la-total="dorm"]', yen(d.fourYear + TUITION_FOUR_YEAR))
      setText('[data-la-total-breakdown="dorm"]', `住居費 ${yen(d.fourYear)} ＋ 学費 ${yen(TUITION_FOUR_YEAR)}`)
    })
  })

  const aptTabs = document.querySelectorAll<HTMLElement>('[data-la-apt-tab]')
  aptTabs.forEach((btn) => {
    btn.addEventListener('click', () => {
      const idx = Number(btn.getAttribute('data-la-apt-tab'))
      const rent = APT_RENTS[idx]
      const a = calcApt(rent.monthly)

      aptTabs.forEach((b) => {
        const active = b === btn
        b.classList.toggle('is-active', active)
        b.setAttribute('aria-selected', active ? 'true' : 'false')
      })

      setText('[data-la-apt-field="rentLabel"]', `家賃（${yen(rent.monthly)}×12か月）`)
      setText('[data-la-apt-field="annualRent"]', yen(a.annualRent))
      setText('[data-la-apt-field="initial"]', yen(a.initial))
      setText('[data-la-apt-field="firstYear"]', yen(a.firstYear))
      setText('[data-la-apt-field="fourYear"]', yen(a.fourYear))
      setText('[data-la-total="apt"]', yen(a.fourYear + TUITION_FOUR_YEAR))
      setText('[data-la-total-breakdown="apt"]', `住居費 ${yen(a.fourYear)} ＋ 学費 ${yen(TUITION_FOUR_YEAR)}`)
    })
  })
</script>
