---
import { ArrowRight, Calendar, Sparkles } from '@lucide/astro'

const ALL_EVENTS = [
  {
    id: 'event-0719',
    heldOn: '2026-07-19',
    date: '7月19日（日）',
    time: '10:30〜11:30（10:00開場）',
    tag: '総合型選抜対策にもピッタリ',
    title: '企業や社会につなぐ「食べる学び」',
    description: '管理栄養士の仕事・活躍・未来を考える、探求型ワークショップ。',
    href: '/event-0719',
  },
  {
    id: 'event-0726',
    heldOn: '2026-07-26',
    date: '7月26日（日）',
    time: '10:30〜11:30（10:00開場）',
    tag: '総合型選抜入試"面接対策"にピッタリ',
    title: '管理栄養士の"伝える"技術を考える',
    description: '大学入試の面接を題材に、AIも活用しながら"自分の意見"を伝える技術を学ぶ。',
    href: '/event-0726',
  },
]

// ビルド時点（JST）で開催日を過ぎたイベントは表示しない。全件終了ならセクションごと非表示。
// 静的サイトのため反映は次回ビルド時（再ビルドなしでは過去イベントが残る点は従来どおり手動運用と同じ）。
const todayJst = new Date().toLocaleDateString('sv-SE', { timeZone: 'Asia/Tokyo' })
const EVENTS = ALL_EVENTS.filter((ev) => ev.heldOn >= todayJst)
---

{EVENTS.length > 0 && (

<section
  class="relative overflow-hidden bg-gradient-to-br from-[#C96C51] to-[#9E4D36] py-[clamp(40px,6vw,64px)]"
  aria-labelledby="upcoming-events-heading"
>
  <div
    class="pointer-events-none absolute -right-16 -top-16 h-64 w-64 rounded-full bg-white/10 blur-3xl"
    aria-hidden="true"
  />
  <div class="container relative z-10 px-[clamp(20px,5vw,72px)]">
    <div class="mb-8 text-center md:mb-10" data-reveal>
      <span class="inline-flex items-center gap-2 rounded-full bg-white/15 px-4 py-1.5 text-[11px] font-medium tracking-[0.15em] text-white/90 uppercase backdrop-blur-sm">
        <Sparkles size={14} aria-hidden="true" />
        参加無料・事前登録受付中
      </span>
      <h2
        id="upcoming-events-heading"
        class="mt-4 text-balance font-serif text-[clamp(22px,3.2vw,32px)] leading-snug font-bold text-white"
      >
        7月開催！管理栄養士について考える探求型イベント
      </h2>
      <p class="mt-2 text-pretty text-[13px] font-light text-white/85">
        高校生・保護者の方向け／十文字学園女子大学 食物栄養学科 特別企画
      </p>
    </div>

    <div class={`mx-auto grid gap-4 md:gap-5 ${EVENTS.length > 1 ? 'md:grid-cols-2' : 'max-w-xl'}`}>
      {EVENTS.map((ev, i) => (
        <a
          href={ev.href}
          class="group relative flex flex-col overflow-hidden rounded-2xl bg-white p-6 shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:shadow-xl"
          data-reveal
          style={`--reveal-delay: ${i * 0.1}s`}
        >
          <div class="flex items-center gap-2 text-[#C96C51]">
            <Calendar size={16} aria-hidden="true" />
            <span class="text-[13px] font-bold">{ev.date}</span>
            <span class="text-[11px] font-light text-[#4A3F3F]/60">{ev.time}</span>
          </div>
          <span class="mt-3 inline-block w-fit rounded-full bg-[#C96C51]/10 px-3 py-1 text-[11px] font-medium text-[#9E4D36]">
            {ev.tag}
          </span>
          <h3 class="mt-3 text-balance font-serif text-[clamp(17px,2vw,20px)] leading-snug font-bold text-[#4A3F3F]">
            {ev.title}
          </h3>
          <p class="mt-2 text-pretty text-[13px] leading-[1.8] font-light text-[#4A3F3F]/75">
            {ev.description}
          </p>
          <span class="mt-4 inline-flex items-center gap-2 text-[13px] font-medium text-[#C96C51]">
            イベント詳細を見る
            <ArrowRight
              size={16}
              class="transition-transform duration-300 group-hover:translate-x-1"
              aria-hidden="true"
            />
          </span>
        </a>
      ))}
      </div>
    </div>
  </section>
)}
