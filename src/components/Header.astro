---
import { ChevronDown } from '@lucide/astro'
import { AUDIENCES } from '../data/audiences.js'

const MENU_CATEGORIES = [
  {
    label: '特集',
    sublabel: 'コンテンツ・記事',
    key: 'feature',
    labs: [
      { name: '管理栄養士になるには', note: '高校生向け進路ガイド', href: '/how-to-become' },
      { name: 'スポーツ栄養特集', note: '食物栄養学科×スポーツの可能性', href: '/sports-nutrition' },
      { name: 'ことサポ', note: '食物栄養学科の伴走支援', href: '/kotosupport' },
      { name: '副専攻', note: '管理栄養士＋もうひとつ。', href: '/submajor' },
      { name: 'コラム', note: '学生・教員のリアルな声', href: '/columns' },
    ],
  },
]

const isHome = Astro.url.pathname === '/'
---

<header class={`header${isHome ? ' header--on-hero' : ''}`} data-home={String(isHome)}>
  <div class="header__inner">

    <a href="/" class="header__logo">
      <div class="header__logo-main">
        <span class="header__logo-dept">食物栄養学科</span>
      </div>
      <span class="header__logo-tagline">十文字学園女子大学 ― 学生・教員による情報メディア</span>
    </a>

    <nav class="header__nav" aria-label="メインナビゲーション">
      <div class="header__audience-chips" aria-label="対象者別メニュー">
        <span class="header__audience-chips-label">あなたに合わせて読む</span>
        {AUDIENCES.map((a) => (
          <a href={a.primaryHref} class="header__audience-chip">{a.shortLabel}</a>
        ))}
      </div>

      <a href="/" class="header__nav-link">ホーム</a>

      <div class="header__cat-wrap header__cat-wrap--audience" data-key="audience">
        <button
          type="button"
          class="header__cat-btn"
          aria-expanded="false"
          aria-haspopup="true"
        >
          あなたへ
          <ChevronDown size={13} class="header__cat-chevron" aria-hidden="true" />
        </button>
        <div class="header__dropdown header__dropdown--audience" aria-hidden="true">
          <p class="header__dropdown-eyebrow">あなたに合わせて読む</p>
          {AUDIENCES.map((a) => (
            <a href={a.primaryHref} class="header__dropdown-item">
              <span class="header__dropdown-name">{a.label}</span>
              <span class="header__dropdown-note">{a.links.map((l) => l.label).join('・')}</span>
            </a>
          ))}
        </div>
      </div>

      <a href="/labs" class="header__nav-link">研究室</a>

      {MENU_CATEGORIES.map(cat => (
        <div class="header__cat-wrap" data-key={cat.key}>
          <button
            type="button"
            class="header__cat-btn"
            aria-expanded="false"
            aria-haspopup="true"
          >
            {cat.label}
            <ChevronDown size={13} class="header__cat-chevron" aria-hidden="true" />
          </button>

          <div class={`header__dropdown header__dropdown--${cat.key}`} aria-hidden="true">
            <p class="header__dropdown-eyebrow">{cat.sublabel}</p>
            {cat.labs.map(lab => (
              <a href={lab.href} class="header__dropdown-item">
                <span class="header__dropdown-name">{lab.name}</span>
                <span class="header__dropdown-note">{lab.note}</span>
              </a>
            ))}
          </div>
        </div>
      ))}

      <a
        href="https://www.jumonji-u.ac.jp/humanlife/food/"
        class="header__official-link"
        target="_blank"
        rel="noopener noreferrer"
      >
        学科公式HP ↗
      </a>

      <a
        href="https://www.jumonji-u.ac.jp/jumonji-style/open-campus/"
        class="header__oc-link"
        target="_blank"
        rel="noopener noreferrer"
        data-ga-click="cta_header_open_campus"
      >
        オープンキャンパス
      </a>
    </nav>

    <button
      class="header__menu-btn"
      aria-label="メニューを開く"
      aria-expanded="false"
    >
      <span></span><span></span><span></span>
    </button>

  </div>
</header>

<script>
  // 旧 Header.jsx の useState/useEffect 群をクラス切替で再現（React不要）
  const header = document.querySelector('.header')
  if (header) {
    const nav = header.querySelector('.header__nav')
    const menuBtn = header.querySelector('.header__menu-btn')
    const wraps = [...header.querySelectorAll('.header__cat-wrap')]
    const isHome = header.getAttribute('data-home') === 'true'
    let menuOpen = false
    let openKey = null

    const applyHeader = () => {
      const scrolled = window.scrollY > 48
      header.classList.toggle('header--scrolled', scrolled)
      header.classList.toggle('header--on-hero', isHome && !scrolled && !menuOpen)
    }

    const applyDropdowns = () => {
      for (const wrap of wraps) {
        const open = openKey === wrap.getAttribute('data-key')
        const btn = wrap.querySelector('.header__cat-btn')
        const dropdown = wrap.querySelector('.header__dropdown')
        btn.classList.toggle('header__cat-btn--active', open)
        btn.setAttribute('aria-expanded', String(open))
        btn.querySelector('.header__cat-chevron')?.classList.toggle('header__cat-chevron--open', open)
        dropdown.classList.toggle('header__dropdown--open', open)
        dropdown.setAttribute('aria-hidden', String(!open))
        dropdown.toggleAttribute('inert', !open)
      }
    }

    const applyMenu = () => {
      nav.classList.toggle('header__nav--open', menuOpen)
      menuBtn.classList.toggle('open', menuOpen)
      menuBtn.setAttribute('aria-expanded', String(menuOpen))
      menuBtn.setAttribute('aria-label', menuOpen ? 'メニューを閉じる' : 'メニューを開く')
      applyHeader()
    }

    const closeAll = () => {
      menuOpen = false
      openKey = null
      applyMenu()
      applyDropdowns()
    }

    window.addEventListener('scroll', applyHeader, { passive: true })

    document.addEventListener('mousedown', (e) => {
      const target = e.target instanceof Node ? e.target : null
      if (!nav.contains(target)) {
        openKey = null
        applyDropdowns()
      }
    })

    for (const wrap of wraps) {
      const key = wrap.getAttribute('data-key')
      wrap.querySelector('.header__cat-btn').addEventListener('click', () => {
        openKey = openKey === key ? null : key
        applyDropdowns()
      })
    }

    menuBtn.addEventListener('click', () => {
      menuOpen = !menuOpen
      applyMenu()
    })

    nav.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeAll))
    header.querySelector('.header__logo').addEventListener('click', closeAll)

    applyHeader()
    applyDropdowns()
  }
</script>
