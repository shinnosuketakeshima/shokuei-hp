---
// Firestoreはビルド時に1回だけ取得する（静的サイト方針。反映は次回デプロイ時）。
import { ArrowLeft, Filter } from '@lucide/astro'
import { collection, getDocs, query, orderBy } from 'firebase/firestore'
import { db } from '../firebase.js'
import { STATIC_NEWS, newsDateMillis, formatNewsDate } from '../newsData.js'

let firestoreNews: any[] = []
try {
  const newsCollectionRef = collection(db, 'news')
  let querySnapshot
  try {
    const q = query(newsCollectionRef, orderBy('date', 'desc'))
    querySnapshot = await getDocs(q)
  } catch {
    querySnapshot = await getDocs(newsCollectionRef)
  }
  firestoreNews = querySnapshot.docs.map((doc) => ({ id: doc.id, ...doc.data() }))
} catch {
  firestoreNews = []
}

const allNews = [
  ...firestoreNews.map((n) => ({
    ...n,
    date: formatNewsDate(n.date),
    type: n.type || 'info',
  })),
  ...STATIC_NEWS,
].sort((a, b) => newsDateMillis(b.date) - newsDateMillis(a.date))

const CATEGORIES = [
  { id: 'all', label: '全て' },
  { id: 'column', label: 'コラム' },
  { id: 'event', label: 'イベント' },
  { id: 'report', label: 'レポート' },
  { id: 'info', label: 'お知らせ' },
]
---

<div class="news-archive-page">
  <div class="container">

    <a href="/" class="lab-page__back-link">
      <ArrowLeft size={16} />
      <span>トップページに戻る</span>
    </a>

    <div class="archive-header" data-reveal>
      <h1 class="archive-title">新着情報・コラム一覧</h1>
      <p class="archive-subtitle">食物栄養学科の最新ニュース、学生・教員のコラムをお届けします。</p>
    </div>

    <div class="archive-filter">
      <div class="archive-filter__label">
        <Filter size={16} />
        <span>絞り込み:</span>
      </div>
      <div class="archive-filter__tabs">
        {CATEGORIES.map((cat) => (
          <button type="button" class="archive-filter__tab" data-archive-filter={cat.id}>
            {cat.label}
          </button>
        ))}
      </div>
    </div>

    <div class="archive-list-container">
      <ul class="archive-list" data-archive-list>
        {allNews.map((n) => (
          <li data-archive-item data-archive-type={n.type}>
            <a href={n.href || '/'} class="archive-item">
              <div class="archive-item__meta">
                <span class="archive-item__date">{n.date}</span>
                <span class={`news-tag news-tag--${n.type}`}>{n.tag}</span>
              </div>
              <h2 class="archive-item__title">{n.title}</h2>
              {n.hook && <p class="archive-item__hook">{n.hook}</p>}
            </a>
          </li>
        ))}
      </ul>

      <p class="archive-empty" data-archive-empty style="display: none;">該当する記事がありません。</p>
    </div>
  </div>
</div>

<script>
  const empty = document.querySelector<HTMLElement>('[data-archive-empty]')
  const buttons = document.querySelectorAll<HTMLElement>('[data-archive-filter]')
  const items = document.querySelectorAll<HTMLElement>('[data-archive-item]')

  function applyFilter(filter: string) {
    let visibleCount = 0
    items.forEach((item) => {
      const match = filter === 'all' || item.getAttribute('data-archive-type') === filter
      item.style.display = match ? '' : 'none'
      if (match) visibleCount++
    })
    if (empty) empty.style.display = visibleCount === 0 ? '' : 'none'
    buttons.forEach((btn) => {
      btn.classList.toggle('is-active', btn.getAttribute('data-archive-filter') === filter)
    })
  }

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      applyFilter(btn.getAttribute('data-archive-filter') || 'all')
    })
  })

  applyFilter('all')
</script>
