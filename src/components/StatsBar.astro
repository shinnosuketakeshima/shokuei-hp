---
const STATS = [
  {
    number: '100', unit: '%',
    label: '就職率',
    note: '(2025年3月卒業生実績)',
  },
  {
    number: '78',   unit: '名',
    label: '募集定員',
    note: '少人数教育を徹底',
  },
  {
    number: '9',    unit: '日間',
    label: '夏期講習（4年次）',
    note: '苦手分野を集中的に克服',
  },
  {
    number: '全国',  unit: '唯一',
    label: '管理栄養士課程で',
    note: '第一種衛生管理者が取れる大学',
  },
]
---

<section class="stats">
  <div class="stats__grid">
    {STATS.map((s, i) => (
      <div class="stats__item" data-reveal="scale" style={`--reveal-delay: ${i * 0.1}s`}>
        <div class="stats__number">
          {s.number}
          <span class="stats__unit">{s.unit}</span>
        </div>
        <div class="stats__label">{s.label}</div>
        <div class="stats__note">{s.note}</div>
      </div>
    ))}
  </div>
</section>
