{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "dist-astro",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/jev/classify",
        "run": {
          "serviceId": "jevclassify",
          "region": "asia-northeast1"
        }
      },
      {
        "source": "/api/patient/speak",
        "run": {
          "serviceId": "patientspeak",
          "region": "asia-northeast1"
        }
      }
    ]
  }
}
